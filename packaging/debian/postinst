#!/bin/sh
set -eu
umask 077
exec 9>/run/fleeting-plugin-aliyun-manager.lock
flock -n 9 || { echo "Another manager operation is in progress." >&2; exit 1; }
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
# Start only after the operator has supplied and checked private configuration.

rm -f /run/fleeting-plugin-aliyun-package-operation
